<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GDLauncher.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Settings"
            FontSize="32"
            FontWeight="SemiBold"
            Margin="0,0,0,24" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Opacity="0.7" />
            <TextBlock
                Text="Các mục cấu hình (đường dẫn game, theme, ngôn ngữ...) sẽ được thêm ở bước sau."
                Opacity="0.6"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
